{
  "name": "typstogether",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "clean": "rm -rf node_modules frontend/node_modules backend/node_modules frontend/dist backend/dist",
    "dev": "bunx concurrently -n backend,frontend -c blue,magenta 'bun run --filter @typstogether/backend dev' 'bun run --filter @typstogether/frontend dev'",
    "format": "bun oxfmt",
    "generate": "bun run --filter @typstogether/backend generate",
    "lint": "bun oxfmt --list-different && bun oxlint",
    "test": "bun test"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.25.0",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "@codemirror/view": "6.42.1"
  },
  "packageManager": "bun@1.3.13"
}
